    { "id": "service", "category": "facts", "turns": [{"role":"user","content":"Ne tamir ediyorsunuz?"}], "all": ["bisiklet"], "none": ["araba.*tamir ediyoruz"], "maxWords": 35 },
    { "id": "helmet", "category": "facts", "turns": [{"role":"user","content":"Kask satıyor musunuz?"}], "all": ["kask"], "any": ["evet|sat"], "maxWords": 25 },
