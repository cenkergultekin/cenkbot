{
  "id": "atlas-microchat", "version": "1", "public": true,
  "cases": [
    { "id": "greeting-tr", "category": "social", "turns": [{"role":"user","content":"merhaba"}], "any": ["merhaba|selam"], "maxWords": 12 },
