{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM"], "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "outDir": "dist", "declaration": true,
    "rootDir": "src", "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"], "exclude": ["src/tests"]
}
