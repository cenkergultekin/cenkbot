OPENROUTER_API_KEY=replace-with-your-key
CENKBOT_MODEL=openrouter/free
CENKBOT_MODE=basic

# Optional: Jev routing + reply review + one rewrite.
# CENKBOT_MODE=reviewed
# TYPESAFE_API_KEY=replace-with-your-key

# Add your website origin when embedding from another domain.
# CENKBOT_ALLOWED_ORIGINS=https://your-portfolio.example

# Optional: authenticated backend-to-backend /v1/chat.
# CENKBOT_SERVICE_TOKEN=use-a-random-token-with-at-least-24-characters
